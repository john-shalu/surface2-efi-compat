diff --git a/drivers/firmware/efi/libstub/file.c b/drivers/firmware/efi/libstub/file.c
--- a/drivers/firmware/efi/libstub/file.c
+++ b/drivers/firmware/efi/libstub/file.c
@@ -329,3 +329,172 @@
 	efi_free(alloc_size, alloc_addr);
 	return status;
 }
+
+// SPDX-License-Identifier: GPL-2.0-only
+/* Surface 2 legacy test.efi compatibility; explicit build-time opt-in. */
+#ifdef CONFIG_EFI_SURFACE2_COMPAT
+static efi_loaded_image_t *surface2_image;
+static void *surface2_cmdline;
+static void *surface2_saved_options;
+static u32 surface2_saved_options_size;
+static bool surface2_legacy;
+static efi_status_t surface2_log_status;
+
+static void surface2_hex(char *p, unsigned long n)
+{
+	static const char digits[] = "0123456789abcdef";
+	int i;
+
+	for (i = 7; i >= 0; i--, n >>= 4)
+		p[i] = digits[n & 15];
+}
+
+void efi_surface2_log(unsigned int stage, efi_status_t result,
+		      unsigned long detail)
+{
+	efi_file_protocol_t *volume = NULL, *file = NULL;
+	efi_status_t status;
+	unsigned long size;
+	char record[128];
+
+	if (!IS_ENABLED(CONFIG_EFI_SURFACE2_BOOT_LOG) || !surface2_image || stage >= 16)
+		return;
+	memset(record, ' ', sizeof(record));
+	memcpy(record, "S2STUB1 stage=", 14);
+	surface2_hex(record + 14, stage);
+	memcpy(record + 23, "status=", 7);
+	surface2_hex(record + 30, result);
+	memcpy(record + 39, "detail=", 7);
+	surface2_hex(record + 46, detail);
+	record[126] = '\r';
+	record[127] = '\n';
+
+	status = efi_open_volume(surface2_image, &volume);
+	if (status != EFI_SUCCESS)
+		goto out;
+	/* The deployment creates this fixed-size file; never create/resize it. */
+	status = efi_call_proto(volume, open, &file,
+		L"\\surface-upgrade\\stub-native\\boot-stage.log",
+		EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0);
+	if (status != EFI_SUCCESS)
+		goto out;
+	status = efi_call_proto(file, set_position, (u64)stage * 128);
+	if (status != EFI_SUCCESS)
+		goto out;
+	size = sizeof(record);
+	status = efi_call_proto(file, write, &size, record);
+	if (status != EFI_SUCCESS)
+		goto out;
+	if (size != sizeof(record)) {
+		status = EFI_DEVICE_ERROR;
+		goto out;
+	}
+	status = efi_call_proto(file, flush);
+out:
+	if (file)
+		efi_call_proto(file, close);
+	if (volume)
+		efi_call_proto(volume, close);
+	surface2_log_status = status;
+}
+
+bool efi_surface2_legacy_active(void)
+{
+	return surface2_legacy;
+}
+
+efi_status_t efi_surface2_prepare(efi_loaded_image_t *image)
+{
+	efi_file_protocol_t *volume = NULL, *file = NULL;
+	struct finfo fi = {
+		.filename = L"\\surface-upgrade\\stub-native\\cmdline.txt",
+	};
+	efi_status_t status;
+	unsigned long size, done = 0, n, len = 0, i;
+	unsigned char *data = NULL;
+	efi_char16_t *wide;
+
+	/* A normal bootloader owns its parameters and DTB; leave them alone. */
+	if (image->load_options && image->load_options_size)
+		return EFI_SUCCESS;
+	surface2_image = image;
+	efi_surface2_log(1, EFI_SUCCESS, (unsigned long)image->image_base);
+	if (surface2_log_status != EFI_SUCCESS)
+		return surface2_log_status;
+	efi_surface2_log(2, EFI_SUCCESS, 0);
+	status = efi_open_volume(image, &volume);
+	if (status != EFI_SUCCESS)
+		goto out;
+	status = efi_open_file(volume, &fi, &file, &size);
+	if (status != EFI_SUCCESS)
+		goto out;
+	if (!size || size > 2048) {
+		status = EFI_BAD_BUFFER_SIZE;
+		goto out;
+	}
+	status = efi_bs_call(allocate_pool, EFI_LOADER_DATA,
+			     (size + 1) * sizeof(efi_char16_t), (void **)&data);
+	if (status != EFI_SUCCESS)
+		goto out;
+	while (done < size) {
+		n = size - done;
+		status = efi_call_proto(file, read, &n, data + done);
+		if (status != EFI_SUCCESS)
+			goto out;
+		if (!n || n > size - done) {
+			status = EFI_DEVICE_ERROR;
+			goto out;
+		}
+		done += n;
+	}
+	len = size;
+	while (len && (data[len - 1] == '\r' || data[len - 1] == '\n' ||
+		       data[len - 1] == ' ' || data[len - 1] == '\t'))
+		len--;
+	if (!len) {
+		status = EFI_INVALID_PARAMETER;
+		goto out;
+	}
+	for (i = 0; i < len; i++) {
+		if (data[i] == '\t')
+			data[i] = ' ';
+		if (data[i] < 0x20 || data[i] > 0x7e) {
+			status = EFI_INVALID_PARAMETER;
+			goto out;
+		}
+	}
+	wide = (efi_char16_t *)data;
+	for (i = len; i; i--)
+		wide[i - 1] = data[i - 1];
+	wide[len] = 0;
+	surface2_saved_options = image->load_options;
+	surface2_saved_options_size = image->load_options_size;
+	image->load_options = wide;
+	image->load_options_size = (len + 1) * sizeof(*wide);
+	surface2_cmdline = data;
+	data = NULL;
+	surface2_legacy = true;
+	status = EFI_SUCCESS;
+out:
+	if (data)
+		efi_bs_call(free_pool, data);
+	if (file)
+		efi_call_proto(file, close);
+	if (volume)
+		efi_call_proto(volume, close);
+	efi_surface2_log(3, status, status == EFI_SUCCESS ? len : done);
+	return status;
+}
+
+void efi_surface2_cleanup(efi_loaded_image_t *image)
+{
+	if (surface2_cmdline) {
+		image->load_options = surface2_saved_options;
+		image->load_options_size = surface2_saved_options_size;
+		efi_bs_call(free_pool, surface2_cmdline);
+		surface2_cmdline = NULL;
+	}
+	surface2_image = NULL;
+	surface2_legacy = false;
+}
+#endif
