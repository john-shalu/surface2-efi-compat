+        return EFI_SUCCESS;
+}
+static inline void efi_surface2_cleanup(efi_loaded_image_t *image) { }
+static inline bool efi_surface2_legacy_active(void) { return false; }
+static inline void efi_surface2_log(unsigned int stage, efi_status_t status,
+                                  unsigned long detail) { }
 #endif
+
+#endif
diff --git a/drivers/firmware/efi/Kconfig b/drivers/firmware/efi/Kconfig
--- a/drivers/firmware/efi/Kconfig
+++ b/drivers/firmware/efi/Kconfig
@@ -100,6 +100,28 @@
 	  functionality for bootloaders that do not have such support
 	  this option is necessary.
 
+config EFI_SURFACE2_COMPAT
+	bool "Surface 2 legacy test.efi file parameters and boot checkpoints"
+	depends on ARM && ARCH_TEGRA && EFI_GENERIC_STUB && EFI_ARMSTUB_DTB_LOADER
+	default n
+	help
+	  Opt-in compatibility for the original Surface 2 Windows boot shim.
+	  If EFI LoadOptions is empty, read the ASCII command line from
+	  \surface-upgrade\stub-native\cmdline.txt on the image filesystem.
+	  Allow its dtb= file even if legacy firmware cannot report SecureBoot.
+	  The DTB must identify microsoft,surface-2. Checkpoints are written
+	  only before ExitBootServices to an existing fixed-size log file.
+	  Normal bootloaders supplying LoadOptions retain standard behaviour.
+
+config EFI_SURFACE2_BOOT_LOG
+	bool "Write Surface 2 EFI boot checkpoints"
+	depends on EFI_SURFACE2_COMPAT
+	default n
+	help
+	  Diagnostic builds only: update a preallocated EFI boot-stage.log
+	  before ExitBootServices. Disable for daily use so the stub only
+	  reads boot files and never writes the EFI filesystem.
+
 config EFI_BOOTLOADER_CONTROL
 	tristate "EFI Bootloader Control"
 	select UCS2_STRING
