@@ -1267,4 +1267,22 @@
 efi_status_t efi_zboot_decompress_init(unsigned long *alloc_size);
 efi_status_t efi_zboot_decompress(u8 *out, unsigned long outlen);
 
+
+#ifdef CONFIG_EFI_SURFACE2_COMPAT
+efi_status_t efi_surface2_prepare(efi_loaded_image_t *image);
+void efi_surface2_cleanup(efi_loaded_image_t *image);
+bool efi_surface2_legacy_active(void);
+void efi_surface2_log(unsigned int stage, efi_status_t status,
+                      unsigned long detail);
+#else
+static inline efi_status_t efi_surface2_prepare(efi_loaded_image_t *image)
